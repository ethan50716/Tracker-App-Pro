        return;
      }
      container.innerHTML = currentAbPitches.map((pt, idx) => `
        <div class="flex items-center justify-between p-1.5 rounded bg-gray-950 border border-gray-800/80">
          <div class="flex items-center space-x-2">
            <span class="text-[10px] font-mono text-gray-500">#${idx + 1}</span>
            <span class="text-xs font-black text-emerald-400">${pt.pitchType}</span>
            <span class="text-[11px] text-gray-300 font-medium">${formatCallName(pt.pitchCall)}</span>
          </div>
          <div class="flex items-center space-x-1.5 text-[10px] font-mono text-gray-400">
            <span>${pt.ballsBefore}-${pt.strikesBefore}</span>
            <span class="text-gray-600">|</span>
            <span class="text-gray-400 font-bold">${pt.zoneDesc.split(' ')[0]}</span>
          </div>
        </div>
      `).join('');
    }

    function renderArsenalTally() {
      const pitchers = getActivePitchers();
      if (pitchers.length === 0) return;
      const p = pitchers[state.gameInfo.currentPitcherIndex];
      document.getElementById('tally-pitcher-label').innerText = `${p.name} (${p.throws[0]}HP)`;

      const pitcherPitches = state.pitches.filter(pt => pt.pitcherId === p.id);
      const types = ['4S', 'SI', 'CT', 'SL', 'CB', 'CH', 'SPL'];
      const tbody = document.getElementById('arsenal-table-body');
      let topWeapon = "None", maxWhiffs = -1;

      tbody.innerHTML = types.map(t => {
        const matching = pitcherPitches.filter(pt => pt.pitchType === t);
        const count = matching.length;
        if (count === 0) return `<tr class="text-gray-600 hover:bg-gray-800/20"><td class="py-1 font-bold">${t}</td><td class="py-1 text-center font-bold">0</td><td class="py-1 text-center">-</td><td class="py-1 text-center">-</td><td class="py-1 text-center">-</td></tr>`;
        
        const strikes = matching.filter(pt => ['StrikeCalled', 'StrikeSwinging', 'FoulBall', 'InPlay'].includes(pt.pitchCall)).length;
        const strPct = ((strikes / count) * 100).toFixed(0);
        const swings = matching.filter(pt => ['StrikeSwinging', 'FoulBall', 'InPlay'].includes(pt.pitchCall)).length;
        const whiffs = matching.filter(pt => pt.pitchCall === 'StrikeSwinging').length;
        const whiffPct = swings > 0 ? ((whiffs / swings) * 100).toFixed(0) : "0";
        const calledStrikes = matching.filter(pt => pt.pitchCall === 'StrikeCalled').length;
        const cswPct = (((whiffs + calledStrikes) / count) * 100).toFixed(0);

        if (whiffs > maxWhiffs && whiffs > 0) { maxWhiffs = whiffs; topWeapon = `${t} (${whiffs} Whiff${whiffs > 1 ? 's' : ''} / ${whiffPct}%)`; }

        return `
          <tr class="text-gray-300 hover:bg-gray-800/40">
            <td class="py-1.5 font-bold text-emerald-400">${t}</td>
            <td class="py-1.5 text-center font-bold text-white">${count}</td>
            <td class="py-1.5 text-center">${strPct}%</td>
            <td class="py-1.5 text-center text-purple-400 font-bold">${whiffPct}% <span class="text-[9px] text-gray-500">(${whiffs})</span></td>
            <td class="py-1.5 text-center text-amber-400 font-bold">${cswPct}%</td>
          </tr>
        `;
      }).join('');

      document.getElementById('tally-top-weapon').innerText = topWeapon === "None" ? "Fastball" : topWeapon;

      const zonePitches = pitcherPitches.filter(pt => pt.zone <= 4).length;
      document.getElementById('tally-zone-rate').innerText = pitcherPitches.length > 0 ? `${((zonePitches / pitcherPitches.length) * 100).toFixed(1)}%` : "0.0%";

      const earlyPitches = pitcherPitches.filter(pt => (pt.ballsBefore === 0 && pt.strikesBefore === 0) || (pt.ballsBefore === 1 && pt.strikesBefore === 0));
      const earlyStr = earlyPitches.filter(pt => ['StrikeCalled', 'StrikeSwinging', 'FoulBall', 'InPlay'].includes(pt.pitchCall)).length;
      document.getElementById('tally-early-str').innerText = earlyPitches.length > 0 ? `${((earlyStr / earlyPitches.length) * 100).toFixed(1)}%` : "0.0%";
    }

    // UPDATED TAB 3 RENDERER
    function renderLineupManager() {
      const team = state.teams[managingTeamId];
      if(!team) return;

      const lContainer = document.getElementById('roster-manage-lineup');
      lContainer.innerHTML = team.lineup.map((b, idx) => `
        <div onclick="openPlayerFormModal('lineup', ${b.id})" class="p-2 rounded bg-gray-950 border border-gray-800 hover:border-emerald-500 cursor-pointer transition">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="text-[10px] font-black font-mono text-gray-500">#${b.order}</span>
              <span class="text-xs font-bold text-white">${b.name}</span>
              <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-gray-800 text-gray-300">${b.bats[0]}HH</span>
            </div>
          </div>
          <div class="flex items-center justify-between mt-1 pt-1 border-t border-gray-900 text-[9px]">
            <span class="font-mono text-gray-400">${b.stats ? `${b.stats.avg} AVG • ${b.stats.hr} HR` : ''}</span>
            <div class="flex space-x-1">${renderArchetypeBadges(b.archetypes)}</div>
          </div>
        </div>
      `).join('');

      const bContainer = document.getElementById('roster-manage-bench');
      bContainer.innerHTML = team.bench.map((b) => `
        <div onclick="openPlayerFormModal('bench', ${b.id})" class="p-2 rounded bg-gray-950 border border-gray-800 hover:border-emerald-500 cursor-pointer transition flex justify-between items-center text-[10px]">
          <div>
            <span class="text-white font-bold">${b.name} <span class="text-gray-500">(${b.bats[0]}HH)</span></span>
          </div>
          <div class="flex space-x-1">${renderArchetypeBadges(b.archetypes)}</div>
        </div>
      `).join('');
      
      const pContainer = document.getElementById('roster-manage-pitchers');
      pContainer.innerHTML = team.pitchers.map((p) => `
        <div onclick="openPlayerFormModal('pitcher', ${p.id})" class="p-2 rounded bg-gray-950 border border-gray-800 hover:border-emerald-500 cursor-pointer transition flex justify-between items-center text-[10px]">
          <span class="text-white font-bold">${p.name}</span>
          <span class="font-mono px-1.5 py-0.5 rounded bg-gray-800 text-gray-300">${p.throws[0]}HP</span>
        </div>
      `).join('');
    }

    function renderGameLog() {
      const tbody = document.getElementById('gamelog-table-body');
      if (state.pitches.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" class="p-4 text-center text-gray-500 italic">No pitches recorded yet</td></tr>`;
        return;
      }
      tbody.innerHTML = state.pitches.slice().reverse().map(pt => `
        <tr class="hover:bg-gray-800/40">
          <td class="p-2 text-gray-500">${pt.pitchNo}</td>
          <td class="p-2">${pt.isTop ? 'T' : 'B'}${pt.inning}</td>
          <td class="p-2 text-white font-bold">${pt.pitcherName.split(',')[0]}</td>
          <td class="p-2">${pt.batterName.split(',')[0]}</td>
          <td class="p-2 text-emerald-400 font-bold">${pt.pitchType}</td>
          <td class="p-2">${formatCallName(pt.pitchCall)}</td>
          <td class="p-2 font-bold">${pt.ballsBefore}-${pt.strikesBefore}</td>
          <td class="p-2 text-gray-400">${pt.zoneDesc.split(' ')[0]}</td>
          <td class="p-2 ${pt.is1_1Win === true ? 'text-emerald-400 font-bold' : (pt.is1_1Win === false ? 'text-rose-400 font-bold' : 'text-gray-600')}">
            ${pt.is1_1Win === true ? 'WIN' : (pt.is1_1Win === false ? 'LOSS' : '-')}
          </td>
        </tr>
      `).join('');
    }

    function switchTab(tabId) {
      ['charting', 'scouting', 'roster', 'gamelog'].forEach(t => {
        const view = document.getElementById(`view-${t}`);
        const btn = document.getElementById(`tab-btn-${t}`);
        if (t === tabId) {
          view.classList.remove('hidden');
          btn.className = "py-2.5 border-b-2 border-emerald-500 text-emerald-400 flex items-center space-x-1.5 font-bold text-xs";
        } else {
          view.classList.add('hidden');
          btn.className = "py-2.5 border-b-2 border-transparent text-gray-400 hover:text-gray-200 flex items-center space-x-1.5 font-bold text-xs";
        }
      });
      lucide.createIcons();
    }

    function loadPlayerScoutingProfile(val) {
      const [type, idStr] = val.split('-');
      const id = parseInt(idStr);
      
      let p = null;
      if (type === 'batter') {
        p = getActiveLineup().find(b => b.id === id) || getActiveBench().find(b => b.id === id);
      } else {
        p = getActivePitchers().find(pi => pi.id === id);
      }
      
      if (p) document.getElementById('scouting-text-input').value = p.notes || "";
    }

    function saveCurrentScoutingText(text) {
      const val = document.getElementById('scouting-player-select').value;
      const [type, idStr] = val.split('-');
      const id = parseInt(idStr);
      
      let p = null;
      if (type === 'batter') {
        p = getActiveLineup().find(b => b.id === id) || getActiveBench().find(b => b.id === id);
      } else {
        p = getActivePitchers().find(pi => pi.id === id);
      }
      if (p) {
        p.notes = text;
        saveState();
        renderCurrentBatter();
      }
    }

    function toggleScoutTag(tagName) {
      const val = document.getElementById('scouting-player-select').value;
      const [type, idStr] = val.split('-');
      if (type !== 'batter') { alert("Quick tags are configured for hitters"); return; }
      
      const b = getActiveLineup().find(x => x.id === parseInt(idStr)) || getActiveBench().find(x => x.id === parseInt(idStr));
      if (!b) return;
      if (!b.tags) b.tags = [];
      const idx = b.tags.indexOf(tagName);
      if (idx === -1) b.tags.push(tagName); else b.tags.splice(idx, 1);
      
      saveState(); renderCurrentBatter();
      showQuickToast(`Updated scouting tags for ${b.name}`);
    }

    function exportToCSV() {
      if (state.pitches.length === 0) { alert("No pitches to export yet!"); return; }

      const headers = [
        "PitchNo", "Time", "Inning", "Top/Bottom", "Outs", "Balls", "Strikes",
        "Pitcher", "PitcherThrows", "Batter", "BatterSide",
        "TaggedPitchType", "PitchCall", "TaggedHitType", "PlayResult",
        "Zone", "ZoneDescription", "Is1_1Count", "Is1_1Win"
      ];

      const rows = state.pitches.map(p => [
        p.pitchNo, `"${p.timestamp}"`, p.inning, p.isTop ? "Top" : "Bottom",
        p.outsBefore, p.ballsBefore, p.strikesBefore, `"${p.pitcherName}"`, p.pitcherThrows,
        `"${p.batterName}"`, p.batterSide, `"${p.taggedPitchType}"`, `"${p.pitchCall}"`,
        `"${p.hitType}"`, `"${p.playResult}"`, p.zone, `"${p.zoneDesc}"`, p.is1_1Count ? 1 : 0,
        p.is1_1Win === true ? 1 : (p.is1_1Win === false ? 0 : "")
      ]);

      const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(e => e.join(","))].join("\n");
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `TrackMan_Matchup_${state.gameInfo.date}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function confirmResetGame() {
      if (confirm("Reset current game tracking? (Ensure you downloaded the CSV first!)")) {
        const oldTeams = JSON.parse(JSON.stringify(state.teams)); // preserve teams
        state = JSON.parse(JSON.stringify(DEFAULT_APP_STATE));
        state.teams = oldTeams; // restore teams after wipe
        saveState(); renderAllViews();
        showQuickToast("Started fresh game tracking session");
      }
    }

    function formatCallName(call) {
      const map = { 'BallCalled': 'Ball', 'StrikeCalled': 'Called Str', 'StrikeSwinging': 'Whiff', 'FoulBall': 'Foul', 'HitByPitch': 'HBP', 'InPlay': 'In Play' };
      return map[call] || call;
    }

    function formatInningOrdinal(n) {
      const s = ["th", "st", "nd", "rd"], v = n % 100;
      return n + (s[(v - 20) % 10] || s[v] || s[0]);
    }
  </script>
