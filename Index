<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Dugout Tracker</title>
  
  <!-- iOS Web App Full-Screen Capabilities -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Dugout Tracker" />
  <link rel="apple-touch-icon" href="https://img.icons8.com/color/180/baseball.png" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script>
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  </script>

  <style>
    * {
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }
    .strike-zone-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(3, 1fr);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #111827;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #374151;
      border-radius: 2px;
    }
    @keyframes pulse-subtle {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.02); }
    }
    .leverage-pulse {
      animation: pulse-subtle 1.8s infinite ease-in-out;
    }
  </style>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen flex flex-col font-sans antialiased overflow-x-hidden">

  <!-- TOP APP BAR -->
  <header class="bg-gray-900 border-b border-gray-800 px-4 py-2.5 sticky top-0 z-40 flex items-center justify-between shadow-lg">
    <div class="flex items-center space-x-3">
      <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-emerald-600/20 text-emerald-400 border border-emerald-500/30">
        <i data-lucide="activity" class="w-5 h-5"></i>
      </div>
      <div>
        <div class="flex items-center space-x-2">
          <h1 class="text-sm font-black tracking-wider uppercase text-white">DUGOUT ANALYTICS</h1>
          <span id="storage-indicator" class="flex items-center text-[10px] bg-emerald-950/80 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded-full font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse mr-1"></span> AUTO-SAVED
          </span>
        </div>
        <p class="text-[11px] text-gray-400 font-medium"><span id="header-matchup">SLU vs Opponent</span></p>
      </div>
    </div>

    <div class="flex items-center space-x-2">
      <div class="flex items-center bg-gray-950 border border-gray-700 rounded-lg px-2.5 py-1">
        <span class="text-[10px] text-gray-400 font-bold uppercase mr-1.5">MOUND:</span>
        <select id="pitcher-select" onchange="switchPitcher(this.value)" class="bg-transparent text-xs font-bold text-emerald-400 outline-none cursor-pointer">
        </select>
      </div>

      <button onclick="rollInning()" title="Roll/Flip Half-Inning" class="flex items-center space-x-1 bg-amber-600/20 hover:bg-amber-600/30 text-amber-300 border border-amber-600/40 text-xs font-bold px-2.5 py-1 rounded-lg transition active:scale-95">
        <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i>
        <span>Roll Inning</span>
      </button>

      <button onclick="exportToCSV()" class="flex items-center space-x-1 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-3 py-1 rounded-lg transition active:scale-95 shadow">
        <i data-lucide="download" class="w-3.5 h-3.5"></i>
        <span>TrackMan CSV</span>
      </button>

      <!-- FULL SCREEN TOGGLE BUTTON -->
      <button onclick="toggleFullScreen()" title="Toggle Full Screen" class="p-1.5 bg-gray-800 hover:bg-emerald-600/30 text-gray-300 hover:text-emerald-400 border border-gray-700 rounded-lg transition active:scale-95">
        <i data-lucide="maximize" id="fullscreen-icon" class="w-4 h-4"></i>
      </button>

      <button onclick="confirmResetGame()" title="New Game / Reset" class="p-1.5 bg-gray-800 hover:bg-red-600/30 text-gray-400 hover:text-red-400 border border-gray-700 rounded-lg transition">
        <i data-lucide="trash-2" class="w-4 h-4"></i>
      </button>
    </div>
  </header>

  <!-- LIVE GAME STATE HUD -->
  <section class="bg-gray-900/90 border-b border-gray-800 px-4 py-2 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2 items-center text-center">
    <div class="bg-gray-950/70 border border-gray-800 rounded-lg p-1.5">
      <span class="text-[10px] text-gray-400 font-semibold block uppercase">INNING</span>
      <div class="flex items-center justify-center space-x-1">
        <span id="inning-side-icon" class="text-xs text-amber-400 font-black">▲ TOP</span>
        <span id="inning-text" class="text-base font-black text-white">1st</span>
      </div>
    </div>

    <div class="bg-gray-950/70 border border-gray-800 rounded-lg p-1.5">
      <span class="text-[10px] text-gray-400 font-semibold block uppercase">COUNT & OUTS</span>
      <div class="flex items-center justify-center space-x-2">
        <span id="count-display" class="text-base font-black text-white tracking-wide">0 - 0</span>
        <span class="text-gray-600 font-black">|</span>
        <div class="flex space-x-1 items-center">
          <span id="out-dot-1" class="w-2.5 h-2.5 rounded-full bg-gray-700 border border-gray-600"></span>
          <span id="out-dot-2" class="w-2.5 h-2.5 rounded-full bg-gray-700 border border-gray-600"></span>
        </div>
      </div>
    </div>

    <div class="bg-gray-950/70 border border-gray-800 rounded-lg p-1.5">
      <span class="text-[10px] text-gray-400 font-semibold block uppercase">PITCHES (TOT / INN)</span>
      <div class="text-base font-black text-emerald-400">
        <span id="hud-total-pitches">0</span> <span class="text-xs text-gray-500 font-normal">/</span> <span id="hud-inn-pitches" class="text-white text-sm">0</span>
      </div>
    </div>

    <div class="bg-gray-950/70 border border-gray-800 rounded-lg p-1.5">
      <span class="text-[10px] text-gray-400 font-semibold block uppercase">STRIKE % (S / B)</span>
      <div class="text-sm font-black text-white">
        <span id="hud-strike-pct" class="text-emerald-400 text-base">0.0%</span>
        <span class="text-[11px] text-gray-400 font-normal">(<span id="hud-strikes">0</span>/<span id="hud-balls">0</span>)</span>
      </div>
    </div>

    <div id="stat-1-1-card" class="bg-gray-950/70 border border-gray-800 rounded-lg p-1.5 relative transition-all duration-300">
      <span class="text-[10px] text-amber-400 font-bold block uppercase flex items-center justify-center">
        <i data-lucide="target" class="w-3 h-3 mr-1 text-amber-400"></i> 1-1 WIN %
      </span>
      <div class="text-sm font-black text-white">
        <span id="hud-1-1-win-pct" class="text-amber-400 text-base">0.0%</span>
        <span class="text-[11px] text-gray-400 font-normal">(<span id="hud-1-1-wins">0</span>/<span id="hud-1-1-total">0</span>)</span>
      </div>
    </div>

    <div class="bg-gray-950/70 border border-gray-800 rounded-lg p-1.5">
      <span class="text-[10px] text-gray-400 font-semibold block uppercase">FPS %</span>
      <div class="text-base font-black text-cyan-400" id="hud-fps-pct">0.0%</div>
    </div>

    <div class="bg-gray-950/70 border border-gray-800 rounded-lg p-1.5">
      <span class="text-[10px] text-gray-400 font-semibold block uppercase">WHIFF % (SWINGS)</span>
      <div class="text-sm font-black text-white">
        <span id="hud-whiff-pct" class="text-purple-400 text-base">0.0%</span>
        <span class="text-[11px] text-gray-400 font-normal">(<span id="hud-whiff-count">0</span>/<span id="hud-swing-count">0</span>)</span>
      </div>
    </div>
  </section>

  <!-- NAVIGATION TABS -->
  <nav class="bg-gray-900 border-b border-gray-800 px-4 flex space-x-6 text-xs font-bold">
    <button onclick="switchTab('charting')" id="tab-btn-charting" class="py-2.5 border-b-2 border-emerald-500 text-emerald-400 flex items-center space-x-1.5">
      <i data-lucide="crosshair" class="w-4 h-4"></i>
      <span>LIVE CHARTING & TALLY</span>
    </button>
    <button onclick="switchTab('scouting')" id="tab-btn-scouting" class="py-2.5 border-b-2 border-transparent text-gray-400 hover:text-gray-200 flex items-center space-x-1.5">
      <i data-lucide="book-open" class="w-4 h-4"></i>
      <span>SCOUTING & CUES HUB</span>
    </button>
    <button onclick="switchTab('roster')" id="tab-btn-roster" class="py-2.5 border-b-2 border-transparent text-gray-400 hover:text-gray-200 flex items-center space-x-1.5">
      <i data-lucide="users" class="w-4 h-4"></i>
      <span>TEAMS & ROSTERS</span>
    </button>
    <button onclick="switchTab('gamelog')" id="tab-btn-gamelog" class="py-2.5 border-b-2 border-transparent text-gray-400 hover:text-gray-200 flex items-center space-x-1.5">
      <i data-lucide="list" class="w-4 h-4"></i>
      <span>PITCH LOG (<span id="tab-pitch-count">0</span>)</span>
    </button>
  </nav>

  <!-- MAIN VIEWPORT -->
  <main class="flex-1 p-3 sm:p-4 max-w-7xl w-full mx-auto">

    <!-- ==================== TAB 1: LIVE CHARTING ==================== -->
    <div id="view-charting" class="grid grid-cols-1 lg:grid-cols-12 gap-4">

      <!-- LEFT COLUMN: BATTER AT-A-GLANCE & HIGHLIGHTED STAT ARCHETYPES -->
      <div class="lg:col-span-3 space-y-3">
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-3.5 shadow-md">
          <div class="flex items-center justify-between border-b border-gray-800 pb-2 mb-2">
            <div>
              <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">AT THE PLATE</span>
              <div class="flex items-center space-x-1.5">
                <span id="batter-order-num" class="bg-gray-800 text-gray-300 text-xs px-1.5 py-0.5 rounded font-black font-mono">#1</span>
                <h3 id="batter-name" class="text-sm font-black text-white">#5 Champagne</h3>
              </div>
            </div>
            <div class="text-right">
              <span id="batter-side-badge" class="bg-blue-950 text-blue-400 border border-blue-800 text-[10px] font-black px-2 py-0.5 rounded uppercase">LHH</span>
              <button onclick="openSubModal()" class="block text-[10px] text-emerald-400 hover:underline mt-1 font-bold">Sub / PH</button>
            </div>
          </div>

          <!-- Highlighted Scout Profile & Archetypes -->
          <div class="bg-gray-950 rounded-lg p-2.5 border border-gray-800 mb-2.5 space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-[9px] text-gray-400 font-bold uppercase">SCOUT PROFILE:</span>
              <span id="batter-statline" class="text-[10px] font-mono text-emerald-400 font-bold">.384 / .470 / .520 • 4 HR • 11 SB</span>
            </div>
            <div id="batter-archetype-badges" class="flex flex-wrap gap-1">
            </div>
          </div>

          <!-- Previous At-Bat Result -->
          <div class="bg-gray-950 rounded-lg p-2 border border-gray-800/80 mb-2.5">
            <span class="text-[9px] text-gray-400 font-bold uppercase block mb-0.5">PREVIOUS AT-BAT:</span>
            <p id="batter-last-ab" class="text-xs font-semibold text-amber-300">No prior plate appearances today</p>
          </div>

          <!-- Live Scouting Cues Overlay -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-[10px] text-gray-400 font-bold uppercase flex items-center">
                <i data-lucide="alert-triangle" class="w-3 h-3 text-amber-400 mr-1"></i> HITTER GAME PLAN
              </span>
              <button onclick="switchTab('scouting')" class="text-[9px] text-gray-400 hover:text-white underline">Edit</button>
            </div>
            <div id="batter-scouting-tags" class="flex flex-wrap gap-1">
            </div>
            <p id="batter-scouting-notes" class="text-[11px] text-gray-300 italic bg-gray-950/60 p-2 rounded border border-gray-800/60">
              Plus runner. C/INF (Fr.) Dutchtown HS. Aggressive contact bat.
            </p>
          </div>
        </div>

        <!-- Previous Pitch Sequence for this Batter -->
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-3 shadow-md">
          <div class="flex items-center justify-between border-b border-gray-800 pb-1.5 mb-2">
            <span class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">CURRENT AB SEQUENCE</span>
            <span id="seq-pitch-count" class="text-[10px] text-gray-400 font-mono">0 Pitches</span>
          </div>
          <div id="sequence-list" class="space-y-1.5 max-h-48 overflow-y-auto custom-scrollbar text-xs">
            <div class="text-[11px] text-gray-500 italic text-center py-3">No pitches thrown this at-bat</div>
          </div>
        </div>
      </div>

      <!-- CENTER COLUMN: RAPID LOGGING INTERFACE & OPTIMIZED STRIKE ZONE -->
      <div class="lg:col-span-5 space-y-3">
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-3.5 shadow-md flex flex-col items-center">
          <div class="w-full flex justify-between items-center mb-2 px-1">
            <span class="text-[10px] text-gray-400 font-bold uppercase flex items-center">
              <i data-lucide="crosshair" class="w-3.5 h-3.5 text-emerald-400 mr-1"></i> TAP LOCATION (OR CHOOSE CALL)
            </span>
            <span id="selected-loc-label" class="text-[10px] font-mono text-emerald-400 font-bold">Location: Up-In (Zone 1)</span>
          </div>

          <!-- STRIKE ZONE INTERFACE -->
          <div class="relative w-full max-w-[340px] sm:max-w-[360px] bg-gray-950 border border-gray-800 rounded-2xl p-2.5 flex flex-col items-center justify-center space-y-2 shadow-inner">
            
            <!-- OUTSIDE 1: CHASE HIGH -->
            <button onclick="selectZone(5, 'Chase High')" id="zone-btn-5" class="w-full py-2 bg-gray-900 hover:bg-emerald-950/40 text-gray-300 hover:text-emerald-300 border border-dashed border-gray-700/80 rounded-xl text-[11px] font-bold uppercase tracking-wider transition active:scale-98">
              ▲ Chase High / Waste
            </button>

            <!-- MIDDLE ROW: CHASE IN - 2X2 IN-ZONE - CHASE AWAY -->
            <div class="w-full flex items-stretch space-x-2">
              <!-- OUTSIDE 2: CHASE ARM / IN -->
              <button onclick="selectZone(6, 'Chase In (Arm)')" id="zone-btn-6" class="w-16 sm:w-20 bg-gray-900 hover:bg-emerald-950/40 text-gray-300 hover:text-emerald-300 border border-dashed border-gray-700/80 rounded-xl text-[10px] font-bold uppercase tracking-tight flex flex-col items-center justify-center p-1 transition active:scale-98 text-center leading-tight">
                <span>◀ In</span>
                <span class="text-[9px] text-gray-400 font-medium">(Arm)</span>
              </button>

              <!-- 2x2 IN-ZONE GRID -->
              <div class="relative flex-1 grid grid-cols-2 grid-rows-2 gap-1.5 h-44 bg-gray-900/90 border-2 border-emerald-500/80 rounded-2xl p-1.5 shadow-inner">
                <button onclick="selectZone(1, 'In-Zone Up-In')" id="zone-btn-1" class="bg-gray-800/90 hover:bg-emerald-600/30 border border-emerald-500/30 rounded-xl flex flex-col items-center justify-center active:scale-95 transition p-1.5">
                  <span id="zone-label-1" class="text-xs sm:text-sm font-bold tracking-tight text-emerald-400 leading-tight">Up-In</span>
                  <span id="zone-sub-1" class="text-[10px] font-mono text-gray-400 mt-0.5">Zone 1</span>
                </button>
                <button onclick="selectZone(2, 'In-Zone Up-Away')" id="zone-btn-2" class="bg-gray-800/90 hover:bg-emerald-600/30 border border-emerald-500/30 rounded-xl flex flex-col items-center justify-center active:scale-95 transition p-1.5">
                  <span id="zone-label-2" class="text-xs sm:text-sm font-bold tracking-tight text-emerald-400 leading-tight">Up-Away</span>
                  <span id="zone-sub-2" class="text-[10px] font-mono text-gray-400 mt-0.5">Zone 2</span>
                </button>
                <button onclick="selectZone(3, 'In-Zone Down-In')" id="zone-btn-3" class="bg-gray-800/90 hover:bg-emerald-600/30 border border-emerald-500/30 rounded-xl flex flex-col items-center justify-center active:scale-95 transition p-1.5">
                  <span id="zone-label-3" class="text-xs sm:text-sm font-bold tracking-tight text-emerald-400 leading-tight">Down-In</span>
                  <span id="zone-sub-3" class="text-[10px] font-mono text-gray-400 mt-0.5">Zone 3</span>
                </button>
                <button onclick="selectZone(4, 'In-Zone Down-Away')" id="zone-btn-4" class="bg-gray-800/90 hover:bg-emerald-600/30 border border-emerald-500/30 rounded-xl flex flex-col items-center justify-center active:scale-95 transition p-1.5">
                  <span id="zone-label-4" class="text-xs sm:text-sm font-bold tracking-tight text-emerald-400 leading-tight">Down-Away</span>
                  <span id="zone-sub-4" class="text-[10px] font-mono text-gray-400 mt-0.5">Zone 4</span>
                </button>
              </div>

              <!-- OUTSIDE 3: CHASE GLOVE / AWAY -->
              <button onclick="selectZone(7, 'Chase Away (Glove)')" id="zone-btn-7" class="w-16 sm:w-20 bg-gray-900 hover:bg-emerald-950/40 text-gray-300 hover:text-emerald-300 border border-dashed border-gray-700/80 rounded-xl text-[10px] font-bold uppercase tracking-tight flex flex-col items-center justify-center p-1 transition active:scale-98 text-center leading-tight">
                <span>Away ▶</span>
                <span class="text-[9px] text-gray-400 font-medium">(Glove)</span>
              </button>
            </div>

            <!-- OUTSIDE 4: CHASE DIRT -->
            <button onclick="selectZone(8, 'Chase Dirt / Below')" id="zone-btn-8" class="w-full py-2 bg-gray-900 hover:bg-emerald-950/40 text-gray-300 hover:text-emerald-300 border border-dashed border-gray-700/80 rounded-xl text-[11px] font-bold uppercase tracking-wider transition active:scale-98">
              ▼ Chase Dirt / Below
            </button>
          </div>

          <!-- Pitch Selection Strip -->
          <div class="w-full mt-3">
            <span class="text-[10px] text-gray-400 font-bold uppercase block mb-1.5 px-1">SELECT PITCH TYPE:</span>
            <div id="pitch-type-buttons" class="grid grid-cols-4 sm:grid-cols-7 gap-1.5">
              <button onclick="selectPitchType('4S')" id="pt-4S" class="py-2.5 rounded-lg bg-emerald-600 text-white font-black text-xs border border-emerald-400 shadow active:scale-95 transition">4S</button>
              <button onclick="selectPitchType('SI')" id="pt-SI" class="py-2.5 rounded-lg bg-gray-800 text-gray-200 hover:bg-gray-700 font-black text-xs border border-gray-700 active:scale-95 transition">SI</button>
              <button onclick="selectPitchType('CT')" id="pt-CT" class="py-2.5 rounded-lg bg-gray-800 text-gray-200 hover:bg-gray-700 font-black text-xs border border-gray-700 active:scale-95 transition">CT</button>
              <button onclick="selectPitchType('SL')" id="pt-SL" class="py-2.5 rounded-lg bg-gray-800 text-gray-200 hover:bg-gray-700 font-black text-xs border border-gray-700 active:scale-95 transition">SL</button>
              <button onclick="selectPitchType('CB')" id="pt-CB" class="py-2.5 rounded-lg bg-gray-800 text-gray-200 hover:bg-gray-700 font-black text-xs border border-gray-700 active:scale-95 transition">CB</button>
              <button onclick="selectPitchType('CH')" id="pt-CH" class="py-2.5 rounded-lg bg-gray-800 text-gray-200 hover:bg-gray-700 font-black text-xs border border-gray-700 active:scale-95 transition">CH</button>
              <button onclick="selectPitchType('SPL')" id="pt-SPL" class="py-2.5 rounded-lg bg-gray-800 text-gray-200 hover:bg-gray-700 font-black text-xs border border-gray-700 active:scale-95 transition">SPL</button>
            </div>
          </div>

          <!-- Direct Pitch Call Action Buttons -->
          <div class="w-full mt-3.5 space-y-2">
            <span class="text-[10px] text-gray-400 font-bold uppercase block px-1">LOG PITCH RESULT:</span>
            <div class="grid grid-cols-3 gap-2">
              <button onclick="recordPitch('BallCalled')" class="py-3 bg-blue-950/80 hover:bg-blue-900 border border-blue-700 text-blue-200 font-black text-xs rounded-xl shadow active:scale-95 flex flex-col items-center justify-center">
                <span class="text-sm">BALL</span>
                <span class="text-[9px] text-blue-400 font-normal">Take / Dirt</span>
              </button>

              <button onclick="recordPitch('StrikeCalled')" class="py-3 bg-amber-950/80 hover:bg-amber-900 border border-amber-600 text-amber-200 font-black text-xs rounded-xl shadow active:scale-95 flex flex-col items-center justify-center">
                <span class="text-sm">CALLED STR</span>
                <span class="text-[9px] text-amber-400 font-normal">Looking</span>
              </button>

              <button onclick="recordPitch('StrikeSwinging')" class="py-3 bg-purple-950/80 hover:bg-purple-900 border border-purple-600 text-purple-200 font-black text-xs rounded-xl shadow active:scale-95 flex flex-col items-center justify-center">
                <span class="text-sm">WHIFF</span>
                <span class="text-[9px] text-purple-400 font-normal">Swinging Strike</span>
              </button>

              <button onclick="recordPitch('FoulBall')" class="py-2.5 bg-gray-800 hover:bg-gray-700 border border-gray-700 text-gray-200 font-black text-xs rounded-xl shadow active:scale-95 flex flex-col items-center justify-center">
                <span>FOUL</span>
                <span class="text-[9px] text-gray-400 font-normal">2-Strike Hold</span>
              </button>

              <button onclick="openInPlayModal()" class="py-2.5 bg-emerald-900/80 hover:bg-emerald-800 border border-emerald-600 text-emerald-200 font-black text-xs rounded-xl shadow active:scale-95 flex flex-col items-center justify-center">
                <span class="text-sm">IN PLAY</span>
                <span class="text-[9px] text-emerald-300 font-normal">Hit / Out / Error</span>
              </button>

              <button onclick="recordPitch('HitByPitch')" class="py-2.5 bg-rose-950/80 hover:bg-rose-900 border border-rose-700 text-rose-300 font-black text-xs rounded-xl shadow active:scale-95 flex flex-col items-center justify-center">
                <span>HBP</span>
                <span class="text-[9px] text-rose-400 font-normal">Hit By Pitch</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: LIVE ARSENAL PITCH TALLY & CSW BREAKDOWN -->
      <div class="lg:col-span-4 space-y-3">
