    function parseRosterCSV(csvText) {
      const lines = csvText.split('\n').map(l => l.trim()).filter(l => l.length > 0);
      if (lines.length <= 1) return;

      const team = state.teams[managingTeamId];
      let imported = 0;
      for (let i = 1; i < lines.length; i++) {
        const parts = lines[i].split(',').map(p => p.replace(/"/g, '').trim());
        if (parts.length >= 1 && parts[0]) {
          const avg = parts[2] || ".250", hr = parseInt(parts[3]) || 0, sb = parseInt(parts[4]) || 0;
          const playerObj = {
            id: Date.now() + i,
            name: parts[0], bats: parts[1] || 'Right',
            stats: { avg: avg, obp: ".340", slg: ".400", hr: hr, sb: sb },
            archetypes: determineArchetypes(parseFloat(avg) || 0.250, 0.400, hr, sb),
            tags: [], notes: "Imported via CSV.", history: []
          };
          if (team.lineup.length < 9) { playerObj.order = team.lineup.length + 1; team.lineup.push(playerObj); } 
          else { team.bench.push(playerObj); }
          imported++;
        }
      }
      if (imported > 0) { saveState(); renderAllViews(); showQuickToast(`Loaded ${imported} players from CSV`); }
    }

