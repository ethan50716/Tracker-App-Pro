  <!-- JAVASCRIPT APPLICATION CODE -->
  <script>
    // V10: Re-architected for multi-team and roster management
    const DEFAULT_APP_STATE = {
      gameInfo: {
        date: new Date().toISOString().split('T')[0],
        pitchingTeamId: 'slu',
        battingTeamId: 'jones',
        inning: 1,
        isTop: true,
        outs: 0,
        balls: 0,
        strikes: 0,
        currentPitcherIndex: 0,
        currentBatterIndex: 0
      },
      teams: {
        'slu': {
          id: 'slu',
          name: 'Southeastern Louisiana',
          pitchers: [
            { id: 1, name: "Robb, Carson", throws: "Right", notes: "Attack top/bottom of zone. Establish FB early." },
            { id: 2, name: "Toups, Nik", throws: "Left", notes: "Heavy sinker 94-95 with 17in run." },
            { id: 3, name: "Fabre, Larson", throws: "Left", notes: "Deceptive slot; arm-side run and sweeper." }
          ],
          lineup: [],
          bench: []
        },
        'jones': {
          id: 'jones',
          name: 'Jones College Bobcats',
          pitchers: [],
          lineup: [
            { id: 501, order: 1, name: "#5 Champagne", bats: "Left", stats: { avg: ".384", obp: ".470", slg: ".520", hr: 4, sb: 11 }, archetypes: ["RUNNER", "CONTACT"], tags: ["Ambush 1st Pitch FB"], notes: "Plus runner.", history: [] },
            { id: 502, order: 2, name: "#14 Theriot", bats: "Right", stats: { avg: ".317", obp: ".420", slg: ".390", hr: 1, sb: 10 }, archetypes: ["RUNNER", "CONTACT"], tags: ["Plus Runner"], notes: "Hahnville HS.", history: [] },
            { id: 503, order: 3, name: "#28 Russell", bats: "Left", stats: { avg: ".371", obp: ".480", slg: ".680", hr: 15, sb: 4 }, archetypes: ["POWER THREAT", "CONTACT"], tags: ["Middle of Order Power"], notes: "Huge power threat.", history: [] }
          ],
          bench: [
            { id: 601, name: "#8 Smith, D.", bats: "Right", stats: { avg: ".278", obp: ".310", slg: ".340", hr: 0, sb: 0 }, archetypes: [], tags: ["Rolls over Sinker Down"], notes: "West Jones HS." }
          ]
        }
      },
      pitches: []
    };

    let state = loadPersistedState();
    let activePitchType = '4S';
    let activeZone = 1;
    let activeZoneDesc = 'Up-In (Zone 1)';
    let selectedTrajectory = 'GroundBall';
    let toastTimeout = null;
    let stagedParsedPlayers = [];
    
    // Team Manager state
    let managingTeamId = state.gameInfo.battingTeamId || Object.keys(state.teams)[0];
    let editingPlayerId = null;

    // Helper Accessors
    function getActivePitchers() { return state.teams[state.gameInfo.pitchingTeamId]?.pitchers || []; }
    function getActiveLineup() { return state.teams[state.gameInfo.battingTeamId]?.lineup || []; }
    function getActiveBench() { return state.teams[state.gameInfo.battingTeamId]?.bench || []; }

    function loadPersistedState() {
      try {
        const saved = localStorage.getItem('SLU_DUGOUT_PITCH_APP_STATE_V10');
        if (saved) return JSON.parse(saved);
      } catch (e) {
        console.warn("Storage fallback", e);
      }
      return JSON.parse(JSON.stringify(DEFAULT_APP_STATE));
    }

    function saveState() {
      try {
        localStorage.setItem('SLU_DUGOUT_PITCH_APP_STATE_V10', JSON.stringify(state));
        flashSavedIndicator();
      } catch (e) {
        console.error("Save error", e);
      }
    }

    function flashSavedIndicator() {
      const ind = document.getElementById('storage-indicator');
      if (ind) {
        ind.classList.remove('text-emerald-400');
        ind.classList.add('text-white');
        setTimeout(() => {
          ind.classList.remove('text-white');
          ind.classList.add('text-emerald-400');
        }, 300);
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      populateTeamManagerSelect();
      populatePitcherSelect();
      populateScoutingSelect();
      selectZone(1, 'Up-In (Zone 1)');
      renderAllViews();
    });

    document.addEventListener('fullscreenchange', updateFullscreenIcon);
    document.addEventListener('webkitfullscreenchange', updateFullscreenIcon);

    function toggleFullScreen() {
      const doc = document.documentElement;
      const isFull = document.fullscreenElement || document.webkitFullscreenElement;
      if (!isFull) {
        if (doc.requestFullscreen) doc.requestFullscreen();
        else if (doc.webkitRequestFullscreen) doc.webkitRequestFullscreen();
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
      }
    }

    function updateFullscreenIcon() {
      const icon = document.getElementById('fullscreen-icon');
      if (!icon) return;
      const isFull = document.fullscreenElement || document.webkitFullscreenElement;
      icon.setAttribute('data-lucide', isFull ? 'minimize' : 'maximize');
      lucide.createIcons();
    }

    // ---------------- TEAM MANAGER FUNCTIONS ---------------- //
    function populateTeamManagerSelect() {
      const sel = document.getElementById('team-manager-select');
      sel.innerHTML = Object.values(state.teams).map(t => 
        `<option value="${t.id}" ${t.id === managingTeamId ? 'selected' : ''}>${t.name}</option>`
      ).join('');
    }

    function changeManagedTeam(teamId) {
      managingTeamId = teamId;
      renderLineupManager(); // Update tab 3 UI
    }

    function createNewTeamPrompt() {
      const tname = prompt("Enter new Team/School Name:");
      if (!tname) return;
      const tid = tname.toLowerCase().replace(/[^a-z0-9]/g, '_') + '_' + Date.now();
      state.teams[tid] = { id: tid, name: tname, pitchers: [], lineup: [], bench: [] };
      managingTeamId = tid;
      saveState();
      populateTeamManagerSelect();
      renderAllViews();
      showQuickToast(`Created new team: ${tname}`);
    }

    function setAsPitchingTeam() {
      state.gameInfo.pitchingTeamId = managingTeamId;
      state.gameInfo.currentPitcherIndex = 0;
      saveState();
      populatePitcherSelect();
      populateScoutingSelect();
      renderAllViews();
      showQuickToast(`Set ${state.teams[managingTeamId].name} as Pitching Staff`);
    }

    function setAsBattingTeam() {
      state.gameInfo.battingTeamId = managingTeamId;
      state.gameInfo.currentBatterIndex = 0;
      saveState();
      populateScoutingSelect();
      renderAllViews();
      showQuickToast(`Set ${state.teams[managingTeamId].name} as Opponent`);
    }

    function updateHeaderMatchup() {
      const pTeam = state.teams[state.gameInfo.pitchingTeamId];
      const bTeam = state.teams[state.gameInfo.battingTeamId];
      document.getElementById('header-matchup').innerText = `${pTeam?.name.substring(0,20) || 'Unknown'} (Mound) vs ${bTeam?.name.substring(0,20) || 'Unknown'} (Plate)`;
    }

    // ---------------- PLAYER MODAL FORM ---------------- //
    function openPlayerFormModal(role, playerId = null) {
      editingPlayerId = playerId;
      const formRole = document.getElementById('form-player-role');
      const formName = document.getElementById('form-player-name');
      const formNum = document.getElementById('form-player-num');
      const formHand = document.getElementById('form-player-hand');
      const formAvg = document.getElementById('form-player-avg');
      const formObp = document.getElementById('form-player-obp');
      const formSlg = document.getElementById('form-player-slg');
      const formHr = document.getElementById('form-player-hr');
      const formSb = document.getElementById('form-player-sb');
      const formNotes = document.getElementById('form-player-notes');
      
      formRole.value = role;
      document.getElementById('form-btn-delete').classList.toggle('hidden', !playerId);

      if (playerId) {
        document.getElementById('form-player-title').innerText = "EDIT PLAYER";
        // Find player
        const t = state.teams[managingTeamId];
        let p = null;
        if (role === 'pitcher') p = t.pitchers.find(x => x.id === playerId);
        else if (role === 'lineup') p = t.lineup.find(x => x.id === playerId);
        else p = t.bench.find(x => x.id === playerId);
        
        if (p) {
          // Parse "#14 Name" format
          const match = p.name.match(/^#(\d+)\s+(.*)$/);
          if (match) {
            formNum.value = match[1];
            formName.value = match[2];
          } else {
            formNum.value = "";
            formName.value = p.name;
          }
          
          formHand.value = (role === 'pitcher') ? p.throws : p.bats;
          formNotes.value = p.notes || "";
          
          if (role !== 'pitcher' && p.stats) {
            formAvg.value = p.stats.avg || ".000";
            formObp.value = p.stats.obp || ".000";
            formSlg.value = p.stats.slg || ".000";
            formHr.value = p.stats.hr || 0;
            formSb.value = p.stats.sb || 0;
          }
        }
      } else {
        document.getElementById('form-player-title').innerText = "ADD NEW PLAYER";
        formName.value = ""; formNum.value = ""; formNotes.value = "";
        formAvg.value = ""; formObp.value = ""; formSlg.value = "";
        formHr.value = ""; formSb.value = "";
      }
      
      togglePlayerFormFields();
      document.getElementById('modal-player-form').classList.remove('hidden');
    }

    function togglePlayerFormFields() {
      const role = document.getElementById('form-player-role').value;
      const statsSection = document.getElementById('form-stats-section');
      statsSection.classList.toggle('hidden', role === 'pitcher');
    }

    function closePlayerFormModal() {
      document.getElementById('modal-player-form').classList.add('hidden');
    }

    function commitPlayerForm() {
      const role = document.getElementById('form-player-role').value;
      const num = document.getElementById('form-player-num').value.trim();
      const rawName = document.getElementById('form-player-name').value.trim();
      const hand = document.getElementById('form-player-hand').value;
      const notes = document.getElementById('form-player-notes').value.trim();
      
      if (!rawName) { alert("Please enter a player name."); return; }
      const displayName = num ? `#${num} ${rawName}` : rawName;
      const team = state.teams[managingTeamId];
      
      let pObj = {
        id: editingPlayerId || Date.now() + Math.floor(Math.random() * 1000),
        name: displayName,
        notes: notes
      };
      
      if (role === 'pitcher') {
        pObj.throws = hand;
        if (editingPlayerId) {
          const idx = team.pitchers.findIndex(x => x.id === editingPlayerId);
          if (idx !== -1) team.pitchers[idx] = { ...team.pitchers[idx], ...pObj };
        } else {
          team.pitchers.push(pObj);
        }
      } else {
        pObj.bats = hand;
        pObj.stats = {
          avg: document.getElementById('form-player-avg').value || ".000",
          obp: document.getElementById('form-player-obp').value || ".000",
          slg: document.getElementById('form-player-slg').value || ".000",
          hr: parseInt(document.getElementById('form-player-hr').value) || 0,
          sb: parseInt(document.getElementById('form-player-sb').value) || 0
        };
        pObj.archetypes = determineArchetypes(parseFloat(pObj.stats.avg) || 0, 0.400, pObj.stats.hr, pObj.stats.sb);
        pObj.tags = ["Manual Entry"];
        
        let targetList = role === 'lineup' ? team.lineup : team.bench;
        if (editingPlayerId) {
          // Find which list it currently exists in and remove it to handle Role swaps
          const oldLineupIdx = team.lineup.findIndex(x => x.id === editingPlayerId);
          const oldBenchIdx = team.bench.findIndex(x => x.id === editingPlayerId);
          
          if (oldLineupIdx !== -1) {
            pObj = { ...team.lineup[oldLineupIdx], ...pObj };
            if (role === 'bench') team.lineup.splice(oldLineupIdx, 1);
          } else if (oldBenchIdx !== -1) {
            pObj = { ...team.bench[oldBenchIdx], ...pObj };
            if (role === 'lineup') team.bench.splice(oldBenchIdx, 1);
          }
          
          // Re-insert into correct list
          if (role === 'lineup' && oldLineupIdx === -1) { pObj.order = team.lineup.length + 1; targetList.push(pObj); }
          else if (role === 'bench' && oldBenchIdx === -1) { targetList.push(pObj); }
          else if (role === 'lineup') { team.lineup[oldLineupIdx] = pObj; }
          else if (role === 'bench') { team.bench[oldBenchIdx] = pObj; }
          
        } else {
          pObj.history = [];
          if (role === 'lineup') pObj.order = team.lineup.length + 1;
          targetList.push(pObj);
        }
      }

      saveState();
      closePlayerFormModal();
      populatePitcherSelect();
      populateScoutingSelect();
      renderAllViews();
      showQuickToast(`Saved player: ${displayName}`);
    }

    function deleteManagedPlayer() {
      if (!confirm("Are you sure you want to delete this player?")) return;
      const team = state.teams[managingTeamId];
      team.pitchers = team.pitchers.filter(x => x.id !== editingPlayerId);
      team.lineup = team.lineup.filter(x => x.id !== editingPlayerId);
      team.bench = team.bench.filter(x => x.id !== editingPlayerId);
      saveState();
      closePlayerFormModal();
      populatePitcherSelect();
      populateScoutingSelect();
      renderAllViews();
      showQuickToast("Player deleted.");
    }

    // ---------------- MAIN LOGIC INTEGRATION ---------------- //
    function populatePitcherSelect() {
      const sel = document.getElementById('pitcher-select');
      const pitchers = getActivePitchers();
      if (pitchers.length === 0) {
        sel.innerHTML = `<option value="0">No Pitchers Loaded</option>`;
        return;
      }
      sel.innerHTML = pitchers.map((p, idx) => 
        `<option value="${idx}" ${idx === state.gameInfo.currentPitcherIndex ? 'selected' : ''}>${p.name} (${p.throws[0]}HP)</option>`
      ).join('');
    }

    function populateScoutingSelect() {
      const sel = document.getElementById('scouting-player-select');
      const lineup = getActiveLineup();
      const bench = getActiveBench();
      const pitchers = getActivePitchers();
      
      sel.innerHTML = `
        <optgroup label="Active Lineup">
          ${lineup.map(b => `<option value="batter-${b.id}">#${b.order} ${b.name} (${b.bats})</option>`).join('')}
        </optgroup>
        <optgroup label="Active Bench">
          ${bench.map(b => `<option value="batter-${b.id}">${b.name} (${b.bats})</option>`).join('')}
        </optgroup>
        <optgroup label="Active Pitching Staff">
          ${pitchers.map(p => `<option value="pitcher-${p.id}">${p.name} (${p.throws})</option>`).join('')}
        </optgroup>
      `;
    }

    function switchPitcher(idx) {
      state.gameInfo.currentPitcherIndex = parseInt(idx);
      saveState();
      renderAllViews();
    }

    function selectPitchType(pt) {
      activePitchType = pt;
      ['4S', 'SI', 'CT', 'SL', 'CB', 'CH', 'SPL'].forEach(t => {
        const btn = document.getElementById(`pt-${t}`);
        if (!btn) return;
        btn.className = (t === pt) 
          ? "py-2.5 rounded-lg bg-emerald-600 text-white font-black text-xs border border-emerald-400 shadow active:scale-95 transition"
          : "py-2.5 rounded-lg bg-gray-800 text-gray-200 hover:bg-gray-700 font-black text-xs border border-gray-700 active:scale-95 transition";
      });
    }

    function selectZone(zoneNum, customDesc) {
      activeZone = zoneNum;
      activeZoneDesc = customDesc || `Zone ${zoneNum}`;
      document.getElementById('selected-loc-label').innerText = `Location: ${activeZoneDesc}`;

      for (let z = 1; z <= 8; z++) {
        const btn = document.getElementById(`zone-btn-${z}`);
        if (!btn) continue;

        if (z <= 4) {
          const title = document.getElementById(`zone-label-${z}`);
          const sub = document.getElementById(`zone-sub-${z}`);
          if (z === zoneNum) {
            btn.className = "bg-emerald-600 border-2 border-emerald-300 rounded-xl flex flex-col items-center justify-center active:scale-95 transition shadow-lg p-1.5";
            if (title) title.className = "text-xs sm:text-sm font-bold tracking-tight text-white leading-tight";
            if (sub) sub.className = "text-[10px] font-mono text-emerald-100 mt-0.5";
          } else {
            btn.className = "bg-gray-800/90 hover:bg-emerald-600/30 border border-emerald-500/30 rounded-xl flex flex-col items-center justify-center active:scale-95 transition p-1.5";
            if (title) title.className = "text-xs sm:text-sm font-bold tracking-tight text-emerald-400 leading-tight";
            if (sub) sub.className = "text-[10px] font-mono text-gray-400 mt-0.5";
          }
        } else {
          if (z === zoneNum) {
            btn.classList.remove('bg-gray-900', 'text-gray-300', 'border-gray-700/80', 'border-dashed');
            btn.classList.add('bg-amber-600/30', 'text-amber-300', 'border-amber-500', 'border-solid');
          } else {
            btn.classList.remove('bg-amber-600/30', 'text-amber-300', 'border-amber-500', 'border-solid');
            btn.classList.add('bg-gray-900', 'text-gray-300', 'border-gray-700/80', 'border-dashed');
          }
        }
      }
    }

    function recordPitch(call, inPlayData = null) {
      const pitchers = getActivePitchers();
      const lineup = getActiveLineup();
      
      if (pitchers.length === 0 || lineup.length === 0) {
        alert("You must add at least 1 pitcher and 1 batter to the active teams before logging pitches.");
        return;
      }

      const pitcher = pitchers[state.gameInfo.currentPitcherIndex];
      const batter = lineup[state.gameInfo.currentBatterIndex];

      const currentBalls = state.gameInfo.balls;
      const currentStrikes = state.gameInfo.strikes;
      const currentOuts = state.gameInfo.outs;

      const is1_1Count = (currentBalls === 1 && currentStrikes === 1);
      let is1_1Win = null;

      if (is1_1Count) {
        if (['StrikeCalled', 'StrikeSwinging', 'FoulBall'].includes(call)) is1_1Win = true;
        else if (call === 'InPlay' && inPlayData && inPlayData.isOut) is1_1Win = true;
        else if (call === 'BallCalled' || call === 'HitByPitch' || (call === 'InPlay' && inPlayData && !inPlayData.isOut)) is1_1Win = false;
      }

      const tmTypeMap = { '4S': 'Fastball', 'SI': 'Sinker', 'CT': 'Cutter', 'SL': 'Slider', 'CB': 'Curveball', 'CH': 'ChangeUp', 'SPL': 'Splitter' };

      const pitchRecord = {
        pitchNo: state.pitches.length + 1,
        inning: state.gameInfo.inning,
        isTop: state.gameInfo.isTop,
        outsBefore: currentOuts,
        ballsBefore: currentBalls,
        strikesBefore: currentStrikes,
        pitcherId: pitcher.id,
        pitcherName: pitcher.name,
        pitcherThrows: pitcher.throws,
        batterId: batter.id,
        batterName: batter.name,
        batterSide: batter.bats,
        pitchType: activePitchType,
        taggedPitchType: tmTypeMap[activePitchType] || 'Fastball',
        pitchCall: call,
        zone: activeZone,
        zoneDesc: activeZoneDesc,
        is1_1Count: is1_1Count,
        is1_1Win: is1_1Win,
        hitType: inPlayData ? inPlayData.trajectory : 'Undefined',
        playResult: inPlayData ? inPlayData.outcome : 'Undefined',
        timestamp: new Date().toLocaleTimeString()
      };

      state.pitches.push(pitchRecord);

      let nextBalls = currentBalls, nextStrikes = currentStrikes, nextOuts = currentOuts;
      let paEnded = false, paSummary = "";

      if (call === 'BallCalled') {
        nextBalls++;
        if (nextBalls >= 4) { paEnded = true; paSummary = "Walk (BB)"; }
      } else if (call === 'StrikeCalled' || call === 'StrikeSwinging') {
        nextStrikes++;
        if (nextStrikes >= 3) {
          paEnded = true; nextOuts++; 
          paSummary = call === 'StrikeCalled' ? "Strikeout (Looking)" : "Strikeout (Swinging)";
        }
      } else if (call === 'FoulBall') {
        if (nextStrikes < 2) nextStrikes++;
      } else if (call === 'HitByPitch') {
        paEnded = true; paSummary = "Hit By Pitch (HBP)";
      } else if (call === 'InPlay') {
        paEnded = true;
        if (inPlayData.isOut) { nextOuts++; paSummary = `${inPlayData.trajectory} Out`; } 
        else { paSummary = `${inPlayData.trajectory} (${inPlayData.outcome})`; }
      }

      showQuickToast(`Pitch ${pitchRecord.pitchNo}: ${activePitchType} - ${formatCallName(call)} (${nextBalls}-${nextStrikes})`);

      if (nextOuts >= 3) {
        state.gameInfo.outs = 0; state.gameInfo.balls = 0; state.gameInfo.strikes = 0;
        state.gameInfo.isTop = !state.gameInfo.isTop;
        if (state.gameInfo.isTop) state.gameInfo.inning++;
        
        if (paEnded) {
          if (!batter.history) batter.history = [];
          batter.history.push({ inning: pitchRecord.inning, result: paSummary });
          advanceToNextBatter();
        }
        showQuickToast(`3 OUTS! Advanced to ${state.gameInfo.isTop ? 'Top' : 'Bot'} ${formatInningOrdinal(state.gameInfo.inning)}`, true);
      } else {
        state.gameInfo.outs = nextOuts;
        if (paEnded) {
          state.gameInfo.balls = 0; state.gameInfo.strikes = 0;
          if (!batter.history) batter.history = [];
          batter.history.push({ inning: pitchRecord.inning, result: paSummary });
          advanceToNextBatter();
        } else {
          state.gameInfo.balls = nextBalls; state.gameInfo.strikes = nextStrikes;
        }
      }

      saveState();
      renderAllViews();
    }

