    async function handleUnifiedFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      const loader = document.getElementById('file-processing-loader');
      const progressText = document.getElementById('file-progress-text');
      loader.classList.remove('hidden');

      if (file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf') {
        progressText.innerText = `Reconstructing PDF table layout from coordinates...`;
        try {
          const arrayBuffer = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
          let tableLines = [];
          for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
            progressText.innerText = `Reading page ${pageNum} coordinates (${pageNum}/${pdf.numPages})...`;
            const page = await pdf.getPage(pageNum);
            const textContent = await page.getTextContent();
            
            const rowMap = new Map();
            textContent.items.forEach(item => {
              const y = Math.round(item.transform[5] / 4) * 4;
              if (!rowMap.has(y)) rowMap.set(y, []);
              rowMap.get(y).push({ x: item.transform[4], text: item.str });
            });

            const sortedYs = Array.from(rowMap.keys()).sort((a, b) => b - a);
            sortedYs.forEach(y => {
              const rowItems = rowMap.get(y).sort((a, b) => a.x - b.x);
              const rowLine = rowItems.map(i => i.text.trim()).filter(t => t.length > 0).join(' ');
              if (rowLine.length > 3) tableLines.push(rowLine);
            });
          }
          loader.classList.add('hidden');
          parseReconstructedLines(tableLines);
        } catch (err) {
          loader.classList.add('hidden'); alert("Error parsing PDF.");
        }
      } else if (file.type.startsWith('image/')) {
        progressText.innerText = "Analyzing screenshot...";
        try {
          const { data: { text } } = await Tesseract.recognize(file, 'eng', { logger: m => { if (m.status === 'recognizing text') progressText.innerText = `OCR: ${Math.round(m.progress * 100)}%`; }});
          loader.classList.add('hidden');
          parseReconstructedLines(text.split('\n'));
        } catch (err) { loader.classList.add('hidden'); alert("OCR read error."); }
      } else if (file.name.endsWith('.csv') || file.type.includes('csv')) {
        const reader = new FileReader();
        reader.onload = function(e) { loader.classList.add('hidden'); parseRosterCSV(e.target.result); };
        reader.readAsText(file);
      }
      
      // Reset input so you can select the same file again if needed
      event.target.value = null;
    }

    function parseReconstructedLines(lines) {
      stagedParsedPlayers = [];
      let orderIndex = 1;

      lines.forEach(rawLine => {
        let line = rawLine.trim();
        if (line.length < 5 || line.toLowerCase().includes("overall statistics") || line.toLowerCase().includes("team leaders")) return;

        const avgMatch = line.match(/(?:\s|^)(\.\d{3}|\d\.\d{3})(?:\s|$)/);
        if (avgMatch) {
          const tokens = line.split(/\s+/);
          let nameTokens = [], avg = avgMatch[1], hr = 0, sb = 0, bats = "Right";

          tokens.forEach((t, idx) => {
            if (/^[A-Za-z]+,?[A-Za-z]*$/.test(t) && !['AVG', 'GP', 'AB', 'R', 'H', 'HR', 'RBI', 'SLG', 'OBP', 'SO', 'BB'].includes(t.toUpperCase())) {
              nameTokens.push(t);
            } else if (/^\d+-\d+$/.test(t)) {
              const val = parseInt(t.split('-')[0]);
              if (val >= 0 && val <= 50) sb = val;
            } else if (!isNaN(t) && idx > 4) {
              const val = parseInt(t);
              if (val > 0 && val <= 40 && hr === 0) hr = val;
            }
          });

          let fullName = nameTokens.join(' ').replace(/[^a-zA-Z,\s#]/g, '').trim();
          if (fullName.length >= 3) {
            stagedParsedPlayers.push({
              name: fullName, bats: bats,
              stats: { avg: avg, obp: ".350", slg: hr > 4 ? ".550" : ".380", hr: hr, sb: sb },
              archetypes: determineArchetypes(parseFloat(avg) || 0.250, 0.400, hr, sb),
              order: orderIndex <= 9 ? orderIndex : null,
              isBench: orderIndex > 9
            });
            orderIndex++;
          }
        }
      });

      if (stagedParsedPlayers.length > 0) openSyncReviewModal();
    }

